{
  "name": "otenki-cli",
  "version": "0.3.0",
  "description": "view weather for any place on earth from the terminal",
  "module": "dist/index.mjs",
  "bin": {
    "otenki": "dist/index.mjs"
  },
  "license": "MIT",
