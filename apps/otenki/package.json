{
  "name": "@nazozokc-prod/otenki",
  "version": "0.2.0",
  "description": "view weather for any place on earth from the terminal",
  "module": "src/index.ts",
  "bin": {
    "otenki": "src/index.ts"
  },
  "license": "MIT",
  "author": {
    "name": "nazozokc",
    "url": "https://github.com/nazozokc"
  },
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/otenki.js --target bun",
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "bun run src/index.ts",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazozokc/otenki.git"
  },
  "homepage": "https://nazozokc.github.io/otenki/",
  "bugs": {
    "url": "https://github.com/nazozokc/otenki/issues"
  },
  "keywords": [
    "weather",
    "cli",
    "terminal",
    "forecast",
    "open-meteo",
    "japan"
  ],
  "devDependencies": {
    "typescript": "^7"
  }
}
