#!/bin/sh
# The stand-in fzf the golden battery runs against. `locate --pick` probes for
# fzf with `--version`, hands the choices in on stdin and reads the answer from
# stdout, so this stub answers the probe and always picks the second line:
# deterministic for whatever candidate list the geocoder produced.
if [ "$1" = "--version" ]; then
  echo "0.64.0 (golden stub)"
  exit 0
fi
sed -n 2p
